# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK (Only needed in production if not using the .json file locally)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Scheduler: interval in minutes for batch price recalculation (default: 30)
SCHEDULER_INTERVAL_MINUTES=30

# Frontend URL (for CORS — set to Vercel URL in production)
FRONTEND_URL=http://localhost:5173
